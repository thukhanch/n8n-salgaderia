# Bridge Baileys para n8n-salgaderia
PORT=3000

# Banco legado da bridge (temporário, enquanto a camada não for isolada)
DB_HOST=localhost
DB_PORT=5432
DB_USER=whatsapp_user
DB_PASS=whatsapp_pass
DB_NAME=whatsapp_flow

# Forward inbound -> n8n
N8N_BRIDGE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/salgaderia/whatsapp
N8N_BRIDGE_WEBHOOK_TOKEN=

# Sessões Baileys
BAILEYS_AUTH_PATH=.sessions

    {
      "parameters": {
        "jsCode": "// Constrói o payload de contexto que vai ao AI Agent\nconst cliente   = $('Upsert Cliente + Get Estado').first().json;\nconst historico = $('Get Histórico (12 últimas)').all().map(i => ({ sender: i.json.sender, msg: i.json.mensagem })).reverse();\nconst msg       = $('Normalize Input').first().json.mensagem;\n\nreturn [{\n  json: {\n    contexto: {\n      estado_atual:  cliente.estado_atual,\n      cliente: {\n        nome:     cliente.nome,\n        telefone: cliente.telefone,\n        endereco: cliente.endereco\n      },\n      carrinho:        cliente.contexto?.carrinho        || [],\n      dados_parciais:  cliente.contexto?.dados_parciais  || {},\n      historico,\n      mensagem_atual:  msg\n    }\n  }\n}];"
      },
      "id": "node-build-context",
      "name": "Build AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        180
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Contexto:\n{{ JSON.stringify($json.contexto, null, 2) }}\n\nResponda em JSON conforme o schema do system message.",
        "options": {
          "systemMessage": "={{ $vars.PROMPT_DONA_SALGADA }}"
        }
      },
      "id": "node-ai-agent",
      "name": "AI Agent (Dona Salgada)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -100,
        180
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.3,
          "responseFormat": "json_object"
        }
      },
      "id": "node-llm",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -100,
        380
      ],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_KEY",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Faz parse do JSON retornado pela IA com fallback seguro.\nlet raw = $json.output ?? $json.text ?? '';\nif (typeof raw === 'object') raw = JSON.stringify(raw);\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g,'').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    resposta_cliente: 'Desculpa, tive um errinho aqui. Pode repetir? 🙏',\n    novo_estado: $('Upsert Cliente + Get Estado').first().json.estado_atual,\n    carrinho: $('Upsert Cliente + Get Estado').first().json.contexto?.carrinho || [],\n    dados_coletados: {},\n    acao: 'NENHUMA',\n    intencao: 'erro_parse'\n  };\n}\nreturn [{ json: parsed }];"
      },
      "id": "node-parse-ai",
      "name": "Parse AI JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clientes SET estado_atual = $2, contexto = $3::jsonb, ultima_msg_em = NOW(), nome = COALESCE(NULLIF($4,''), nome) WHERE telefone = $1 RETURNING telefone;",
        "options": {
          "queryReplacement": "={{ $('Normalize Input').item.json.telefone }},={{ $json.novo_estado }},={{ JSON.stringify({ carrinho: $json.carrinho, dados_parciais: $json.dados_coletados }) }},={{ $json.dados_coletados?.nome || '' }}"
        }
      },
      "id": "node-update-estado",

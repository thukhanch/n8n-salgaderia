    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO clientes (telefone, nome) VALUES ($1, NULLIF($2,'')) ON CONFLICT (telefone) DO UPDATE SET ultima_msg_em = NOW(), nome = COALESCE(clientes.nome, EXCLUDED.nome) RETURNING telefone, nome, endereco, estado_atual, contexto;",
        "options": {
          "queryReplacement": "={{ $json.telefone }},={{ $json.nome_wa }}"
        }
      },

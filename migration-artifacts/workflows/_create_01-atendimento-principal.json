    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH novo AS (\n  INSERT INTO pedidos (\n    telefone, nome_cliente, itens, quantidade_total, valor_total,\n    tipo_entrega, endereco, forma_pagamento, status, observacao\n  ) VALUES (\n    $1, $2, $3::jsonb, $4, $5, $6, NULLIF($7,''), $8,\n    CASE WHEN $8='pix' THEN 'NOVO' ELSE 'PAGO' END,\n    NULLIF($9,'')\n  ) RETURNING *\n)\nUPDATE clientes SET estado_atual='PEDIDO_CONFIRMADO', contexto='{}'::jsonb WHERE telefone=$1\nRETURNING (SELECT row_to_json(novo) FROM novo) AS pedido;",
        "options": {
          "queryReplacement": "={{ $('Normalize Input').item.json.telefone }},={{ $('Parse AI JSON').item.json.dados_coletados.nome }},={{ JSON.stringify($('Parse AI JSON').item.json.carrinho) }},={{ ($('Parse AI JSON').item.json.carrinho || []).reduce((s,i)=>s+(i.qtd||0),0) }},={{ ($('Parse AI JSON').item.json.carrinho || []).reduce((s,i)=>s+((i.qtd||0)*(i.preco_unit||0)),0) + ($('Parse AI JSON').item.json.dados_coletados.tipo_entrega==='entrega'?5:0) }},={{ $('Parse AI JSON').item.json.dados_coletados.tipo_entrega }},={{ $('Parse AI JSON').item.json.dados_coletados.endereco || '' }},={{ $('Parse AI JSON').item.json.dados_coletados.forma_pagamento }},={{ $('Parse AI JSON').item.json.dados_coletados.observacao || '' }}"
        }
      },

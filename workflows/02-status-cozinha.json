{
  "name": "Salgaderia - 02 Status Cozinha (callback)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "salgaderia/cozinha-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-wh",
      "name": "Webhook Cozinha",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1200, 240],
      "webhookId": "salgaderia-cozinha-status"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {"id":"auth","leftValue":"={{ $json.headers.authorization }}","rightValue":"=Bearer {{ $vars.COZINHA_TOKEN }}","operator":{"type":"string","operation":"equals"}}
          ],
          "combinator": "and"
        }
      },
      "id": "node-auth",
      "name": "Auth",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-980, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id":"1","name":"codigo","value":"={{ $json.body.codigo }}","type":"number"},
            {"id":"2","name":"novo_status","value":"={{ $json.body.status }}","type":"string"}
          ]
        }
      },
      "id": "node-set",
      "name": "Set Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-760, 180]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pedidos SET status=$2 WHERE codigo=$1 RETURNING *;",
        "options": {"queryReplacement":"={{ $json.codigo }},={{ $json.novo_status }}"}
      },
      "id": "node-upd",
      "name": "Update Pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-540, 180],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"s1","leftValue":"={{ $json.status }}","rightValue":"EM_PREPARO","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"EM_PREPARO"},
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"s2","leftValue":"={{ $json.status }}","rightValue":"PRONTO","operator":{"type":"string","operation":"equals"}},{"id":"s2b","leftValue":"={{ $json.tipo_entrega }}","rightValue":"entrega","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"PRONTO_ENTREGA"},
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"s3","leftValue":"={{ $json.status }}","rightValue":"PRONTO","operator":{"type":"string","operation":"equals"}},{"id":"s3b","leftValue":"={{ $json.tipo_entrega }}","rightValue":"retirada","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"PRONTO_RETIRADA"},
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"s4","leftValue":"={{ $json.status }}","rightValue":"ENTREGUE","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"ENTREGUE"}
          ]
        },
        "options": {"fallbackOutput": "none"}
      },
      "id": "node-switch",
      "name": "Switch Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-320, 180]
    },
    {
      "parameters": {
        "workflowId": {"__rl": true, "value": "WF_MOTOBOY", "mode": "list"},
        "workflowInputs": {"value": "={{ { pedido: $json } }}"},
        "options": {"waitForSubWorkflow": true}
      },
      "id": "node-call-motoboy",
      "name": "Execute: Motoboy",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Update Pedido').first().json;\nconst status = p.status;\nconst tipo = p.tipo_entrega;\nconst map = {\n  EM_PREPARO:     `🔥 Seu pedido #${p.codigo} tá na fritura! Fica pronto em ~20 min.`,\n  PRONTO_RETIRADA: `🥟 Pedido #${p.codigo} PRONTO! Pode vir buscar.`,\n  PRONTO_ENTREGA:  `✅ Pedido #${p.codigo} pronto! Chamando o motoboy, já te mando o link do rastreio.`,\n  ENTREGUE:       `🙌 Pedido #${p.codigo} entregue! Obrigada pela preferência.`\n};\nconst key = (status==='PRONTO') ? (tipo==='entrega'?'PRONTO_ENTREGA':'PRONTO_RETIRADA') : status;\nreturn [{ json: { telefone: p.telefone, texto: map[key] || `Pedido #${p.codigo}: ${status}` } }];"
      },
      "id": "node-msg",
      "name": "Compor Msg",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [120, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://{{ $vars.BAILEYS_HOST }}/send-text",
        "sendHeaders": true,
        "headerParameters": {"parameters":[
          {"name":"Authorization","value":"=Bearer {{ $vars.BAILEYS_SERVICE_TOKEN }}"},
          {"name":"Content-Type","value":"application/json"}
        ]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.telefone, text: $json.texto }) }}"
      },
      "id": "node-send",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [340, 180]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clientes SET estado_atual = CASE WHEN $2 IN ('ENTREGUE','CANCELADO') THEN 'FINALIZADO' WHEN $2='EM_PREPARO' THEN 'EM_PREPARO' WHEN $2='PRONTO' THEN 'PRONTO' WHEN $2='SAIU_ENTREGA' THEN 'SAIU_ENTREGA' ELSE estado_atual END WHERE telefone=$1;",
        "options": {"queryReplacement":"={{ $('Update Pedido').item.json.telefone }},={{ $('Update Pedido').item.json.status }}"}
      },
      "id": "node-sync",
      "name": "Sync Estado Cliente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [560, 180],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {"respondWith":"json","responseBody":"={\"ok\":true}","options":{"responseCode":200}},
      "id": "node-ok",
      "name": "OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 180]
    },
    {
      "parameters": {"respondWith":"json","responseBody":"={\"ok\":false}","options":{"responseCode":401}},
      "id": "node-401",
      "name": "401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-760, 380]
    }
  ],
  "connections": {
    "Webhook Cozinha":    { "main": [[{"node":"Auth","type":"main","index":0}]] },
    "Auth":               { "main": [ [{"node":"Set Status","type":"main","index":0}], [{"node":"401","type":"main","index":0}] ] },
    "Set Status":         { "main": [[{"node":"Update Pedido","type":"main","index":0}]] },
    "Update Pedido":      { "main": [[{"node":"Switch Status","type":"main","index":0}]] },
    "Switch Status":      { "main": [
      [{"node":"Compor Msg","type":"main","index":0}],
      [{"node":"Execute: Motoboy","type":"main","index":0},{"node":"Compor Msg","type":"main","index":0}],
      [{"node":"Compor Msg","type":"main","index":0}],
      [{"node":"Compor Msg","type":"main","index":0}]
    ]},
    "Execute: Motoboy":   { "main": [[]] },
    "Compor Msg":         { "main": [[{"node":"Enviar WhatsApp","type":"main","index":0}]] },
    "Enviar WhatsApp":    { "main": [[{"node":"Sync Estado Cliente","type":"main","index":0}]] },
    "Sync Estado Cliente":{ "main": [[{"node":"OK","type":"main","index":0}]] }
  },
  "active": false,
  "settings": {"executionOrder":"v1","saveDataErrorExecution":"all"},
  "tags": [{"name":"salgaderia"},{"name":"cozinha"}]
}

{
  "name": "Salgaderia - 07 Google Calendar (agenda de produção e retirada)",
  "nodes": [
    {
      "parameters": {},
      "id": "node-start",
      "name": "When Called by Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-1400, 0]
    },
    {
      "parameters": {
        "jsCode": "// Calcula horário previsto: agora + 25 min (fritura) ou agora + 45 min (entrega)\nconst p = $json.pedido;\nconst base = new Date();\nconst minutos = p.tipo_entrega === 'entrega' ? 45 : 25;\nconst inicio = new Date(base.getTime() + minutos*60000);\nconst fim    = new Date(inicio.getTime() + 15*60000);\nreturn [{ json: {\n  pedido_id: p.id,\n  codigo: p.codigo,\n  summary: `Pedido #${p.codigo} - ${p.nome_cliente} (${p.tipo_entrega})`,\n  description: `Cliente: ${p.nome_cliente}\\nTel: ${p.telefone}\\nItens: ${(p.itens||[]).map(i=>`${i.qtd}x ${i.produto}`).join(', ')}\\nTotal: R$ ${Number(p.valor_total).toFixed(2)}\\nPagamento: ${p.forma_pagamento}${p.observacao?('\\nObs: '+p.observacao):''}`,\n  location: p.tipo_entrega === 'entrega' ? (p.endereco || '') : 'Salgaderia (retirada)',\n  start: inicio.toISOString(),\n  end:   fim.toISOString()\n} }];"
      },
      "id": "node-prep",
      "name": "Preparar Evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1180, 0]
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {"__rl":true,"value":"={{ $vars.GCAL_CALENDAR_ID }}","mode":"id"},
        "start": "={{ $json.start }}",
        "end":   "={{ $json.end }}",
        "additionalFields": {
          "summary":     "={{ $json.summary }}",
          "description": "={{ $json.description }}",
          "location":    "={{ $json.location }}",
          "colorId":     "={{ $json.location.includes('retirada') ? '10' : '11' }}"
        }
      },
      "id": "node-gcal",
      "name": "Google Calendar: Create Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [-960, 0],
      "credentials": {"googleCalendarOAuth2Api": {"id":"GCAL_OAUTH","name":"Google Calendar"}}
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pedidos SET gcal_event_id=$2, horario_previsto=$3::timestamptz WHERE id=$1::uuid;",
        "options": {"queryReplacement":"={{ $('Preparar Evento').item.json.pedido_id }},={{ $json.id }},={{ $('Preparar Evento').item.json.start }}"}
      },
      "id": "node-save",
      "name": "Salvar event_id",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-740, 0],
      "credentials": {"postgres": {"id":"PG_SALGADERIA","name":"Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "httpMethod":"POST",
        "path":"salgaderia/gcal-update",
        "responseMode":"responseNode"
      },
      "id":"node-wh-upd",
      "name":"Webhook Update Event",
      "type":"n8n-nodes-base.webhook",
      "typeVersion":2,
      "position":[-1400,400],
      "webhookId":"salgaderia-gcal-update"
    },
    {
      "parameters": {
        "conditions":{"options":{"caseSensitive":true,"typeValidation":"strict"},"conditions":[{"id":"auth","leftValue":"={{ $json.headers.authorization }}","rightValue":"=Bearer {{ $vars.COZINHA_TOKEN }}","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}
      },
      "id":"node-auth",
      "name":"Auth",
      "type":"n8n-nodes-base.if",
      "typeVersion":2,
      "position":[-1180,400]
    },
    {
      "parameters": {
        "operation":"executeQuery",
        "query":"SELECT gcal_event_id, codigo, status FROM pedidos WHERE codigo=$1::int;",
        "options":{"queryReplacement":"={{ $json.body.codigo }}"}
      },
      "id":"node-fetch",
      "name":"Buscar event_id",
      "type":"n8n-nodes-base.postgres",
      "typeVersion":2.5,
      "position":[-960,400],
      "credentials":{"postgres":{"id":"PG_SALGADERIA","name":"Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "resource":"event",
        "operation":"update",
        "calendar":{"__rl":true,"value":"={{ $vars.GCAL_CALENDAR_ID }}","mode":"id"},
        "eventId":"={{ $json.gcal_event_id }}",
        "updateFields":{
          "summary":"=Pedido #{{ $json.codigo }} [{{ $json.status }}]",
          "colorId":"={{ $json.status === 'ENTREGUE' ? '2' : ($json.status === 'CANCELADO' ? '8' : '5') }}"
        }
      },
      "id":"node-upd",
      "name":"Update Event",
      "type":"n8n-nodes-base.googleCalendar",
      "typeVersion":1.3,
      "position":[-740,400],
      "credentials":{"googleCalendarOAuth2Api":{"id":"GCAL_OAUTH","name":"Google Calendar"}}
    },
    {
      "parameters": {"respondWith":"json","responseBody":"={\"ok\":true}","options":{"responseCode":200}},
      "id":"node-ok",
      "name":"OK",
      "type":"n8n-nodes-base.respondToWebhook",
      "typeVersion":1.1,
      "position":[-520,400]
    }
  ],
  "connections": {
    "When Called by Workflow":{ "main": [[{"node":"Preparar Evento","type":"main","index":0}]] },
    "Preparar Evento":        { "main": [[{"node":"Google Calendar: Create Event","type":"main","index":0}]] },
    "Google Calendar: Create Event":{ "main": [[{"node":"Salvar event_id","type":"main","index":0}]] },

    "Webhook Update Event":   { "main": [[{"node":"Auth","type":"main","index":0}]] },
    "Auth":                   { "main": [[{"node":"Buscar event_id","type":"main","index":0}],[{"node":"OK","type":"main","index":0}]] },
    "Buscar event_id":        { "main": [[{"node":"Update Event","type":"main","index":0}]] },
    "Update Event":           { "main": [[{"node":"OK","type":"main","index":0}]] }
  },
  "active": false,
  "settings": {"executionOrder":"v1","saveDataErrorExecution":"all"},
  "tags": [{"name":"salgaderia"},{"name":"google-calendar"}]
}

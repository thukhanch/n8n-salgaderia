{
  "name": "Salgaderia - 01 Atendimento Principal (Baileys)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "salgaderia/whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-in",
      "name": "Webhook Baileys",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1640, 240],
      "webhookId": "salgaderia-whatsapp"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {"id":"auth","leftValue":"={{ $json.headers.authorization || '' }}","rightValue":"=Bearer {{ $vars.BAILEYS_SERVICE_TOKEN }}","operator":{"type":"string","operation":"equals"}}
          ],
          "combinator": "and"
        }
      },
      "id": "node-auth",
      "name": "Auth Token Baileys",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1420, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id":"1","name":"telefone","value":"={{ $json.body.telefone }}","type":"string"},
            {"id":"2","name":"nome_wa","value":"={{ $json.body.pushName || '' }}","type":"string"},
            {"id":"3","name":"mensagem","value":"={{ $json.body.text || '' }}","type":"string"},
            {"id":"4","name":"tipo_msg","value":"={{ $json.body.messageType || 'text' }}","type":"string"},
            {"id":"5","name":"from_me","value":"={{ $json.body.fromMe || false }}","type":"boolean"},
            {"id":"6","name":"has_media","value":"={{ $json.body.hasMedia || false }}","type":"boolean"}
          ]
        }
      },
      "id": "node-normalize",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1200, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {"id":"c1","leftValue":"={{ $json.from_me }}","rightValue":true,"operator":{"type":"boolean","operation":"false"}},
            {"id":"c2","leftValue":"={{ $json.telefone }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}},
            {"id":"c3","leftValue":"={{ $json.mensagem }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}
          ],
          "combinator": "and"
        }
      },
      "id": "node-guard",
      "name": "Guard",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-980, 180]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO clientes (telefone, nome) VALUES ($1, NULLIF($2,'')) ON CONFLICT (telefone) DO UPDATE SET ultima_msg_em = NOW(), nome = COALESCE(clientes.nome, EXCLUDED.nome) RETURNING telefone, nome, endereco, estado_atual, contexto;",
        "options": {"queryReplacement":"={{ $json.telefone }},={{ $json.nome_wa }}"}
      },
      "id": "node-upsert-cliente",
      "name": "Upsert Cliente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-760, 120],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversas (telefone, sender, mensagem) VALUES ($1, 'cliente', $2);",
        "options": {"queryReplacement":"={{ $('Normalize Input').item.json.telefone }},={{ $('Normalize Input').item.json.mensagem }}"}
      },
      "id": "node-log-in",
      "name": "Log Msg Cliente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-540, 120],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sender, mensagem, criado_em FROM conversas WHERE telefone = $1 ORDER BY criado_em DESC LIMIT 12;",
        "options": {"queryReplacement":"={{ $('Normalize Input').item.json.telefone }}"}
      },
      "id": "node-historico",
      "name": "Get Histórico",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-320, 120],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "jsCode": "const cliente = $('Upsert Cliente').first().json;\nconst historico = $('Get Histórico').all().map(i => ({ sender: i.json.sender, msg: i.json.mensagem })).reverse();\nconst msg = $('Normalize Input').first().json.mensagem;\nreturn [{ json: { contexto: {\n  estado_atual: cliente.estado_atual,\n  cliente: { nome: cliente.nome, telefone: cliente.telefone, endereco: cliente.endereco },\n  carrinho: cliente.contexto?.carrinho || [],\n  dados_parciais: cliente.contexto?.dados_parciais || {},\n  historico,\n  mensagem_atual: msg\n}}}];"
      },
      "id": "node-ctx",
      "name": "Build AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 120]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Contexto:\n{{ JSON.stringify($json.contexto, null, 2) }}\n\nResponda em JSON conforme o schema do system message.",
        "options": {"systemMessage": "={{ $vars.PROMPT_DONA_SALGADA }}"}
      },
      "id": "node-ai",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [120, 120]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {"temperature": 0.3, "responseFormat": "json_object"}
      },
      "id": "node-llm",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [120, 320],
      "credentials": {"openAiApi": {"id": "OPENAI_KEY", "name": "OpenAI"}}
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.output ?? $json.text ?? '';\nif (typeof raw === 'object') raw = JSON.stringify(raw);\nlet p;\ntry { p = JSON.parse(raw.replace(/```json|```/g,'').trim()); }\ncatch { p = { resposta_cliente:'Desculpa, tive um errinho. Pode repetir?', novo_estado:$('Upsert Cliente').first().json.estado_atual, carrinho:$('Upsert Cliente').first().json.contexto?.carrinho||[], dados_coletados:{}, acao:'NENHUMA', intencao:'erro_parse' }; }\nreturn [{ json: p }];"
      },
      "id": "node-parse",
      "name": "Parse AI JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 120]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clientes SET estado_atual=$2, contexto=$3::jsonb, ultima_msg_em=NOW(), nome=COALESCE(NULLIF($4,''),nome), endereco=COALESCE(NULLIF($5,''),endereco) WHERE telefone=$1 RETURNING telefone;",
        "options": {"queryReplacement":"={{ $('Normalize Input').item.json.telefone }},={{ $json.novo_estado }},={{ JSON.stringify({ carrinho:$json.carrinho, dados_parciais:$json.dados_coletados }) }},={{ $json.dados_coletados?.nome || '' }},={{ $json.dados_coletados?.endereco || '' }}"}
      },
      "id": "node-upd-estado",
      "name": "Update Estado Cliente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 120],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"s1","leftValue":"={{ $('Parse AI JSON').item.json.acao }}","rightValue":"CRIAR_PEDIDO","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"CRIAR_PEDIDO"},
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"s2","leftValue":"={{ $('Parse AI JSON').item.json.acao }}","rightValue":"ESCALAR_HUMANO","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"ESCALAR_HUMANO"},
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"s3","leftValue":"={{ $('Parse AI JSON').item.json.acao }}","rightValue":"CANCELAR","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"CANCELAR"}
          ]
        },
        "options": {"fallbackOutput": "extra"}
      },
      "id": "node-switch",
      "name": "Switch por acao",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [880, 120]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH novo AS (\n  INSERT INTO pedidos (telefone, nome_cliente, itens, quantidade_total, valor_total, taxa_entrega, tipo_entrega, endereco, forma_pagamento, status, observacao)\n  VALUES ($1, $2, $3::jsonb, $4, $5, $6, $7, NULLIF($8,''), $9,\n    CASE WHEN $9='pix' THEN 'AGUARDANDO_PAGAMENTO' ELSE 'PAGO' END,\n    NULLIF($10,'')) RETURNING *)\nUPDATE clientes SET estado_atual='PEDIDO_CONFIRMADO', contexto='{}'::jsonb WHERE telefone=$1\nRETURNING (SELECT row_to_json(novo) FROM novo) AS pedido;",
        "options": {"queryReplacement":"={{ $('Normalize Input').item.json.telefone }},={{ $('Parse AI JSON').item.json.dados_coletados.nome }},={{ JSON.stringify($('Parse AI JSON').item.json.carrinho) }},={{ ($('Parse AI JSON').item.json.carrinho||[]).reduce((s,i)=>s+(i.qtd||0),0) }},={{ ($('Parse AI JSON').item.json.carrinho||[]).reduce((s,i)=>s+((i.qtd||0)*(i.preco_unit||0)),0) + ($('Parse AI JSON').item.json.dados_coletados.tipo_entrega==='entrega'?5:0) }},={{ $('Parse AI JSON').item.json.dados_coletados.tipo_entrega==='entrega'?5:0 }},={{ $('Parse AI JSON').item.json.dados_coletados.tipo_entrega }},={{ $('Parse AI JSON').item.json.dados_coletados.endereco||'' }},={{ $('Parse AI JSON').item.json.dados_coletados.forma_pagamento }},={{ $('Parse AI JSON').item.json.dados_coletados.observacao||'' }}"}
      },
      "id": "node-criar-pedido",
      "name": "Criar Pedido (DB)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, -120],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {"conditions":{"options":{"caseSensitive":false},"conditions":[{"id":"pix","leftValue":"={{ $json.pedido.forma_pagamento }}","rightValue":"pix","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"PIX"}
          ]
        },
        "options": {"fallbackOutput": "extra"}
      },
      "id": "node-switch-pag",
      "name": "Switch Pagamento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1320, -120]
    },
    {
      "parameters": {
        "workflowId": {"__rl": true, "value": "WF_MERCADOPAGO", "mode": "list"},
        "workflowInputs": {"value": "={{ { pedido: $json.pedido } }}"},
        "options": {"waitForSubWorkflow": true}
      },
      "id": "node-call-mp",
      "name": "Execute: MercadoPago Pix",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1540, -220]
    },
    {
      "parameters": {
        "workflowId": {"__rl": true, "value": "WF_PRINTER", "mode": "list"},
        "workflowInputs": {"value": "={{ { pedido: $('Criar Pedido (DB)').item.json.pedido } }}"},
        "options": {"waitForSubWorkflow": false}
      },
      "id": "node-call-printer",
      "name": "Execute: Printer",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1540, -20]
    },
    {
      "parameters": {
        "workflowId": {"__rl": true, "value": "WF_GCAL", "mode": "list"},
        "workflowInputs": {"value": "={{ { pedido: $('Criar Pedido (DB)').item.json.pedido } }}"},
        "options": {"waitForSubWorkflow": false}
      },
      "id": "node-call-gcal",
      "name": "Execute: Google Calendar",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1540, 120]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clientes SET estado_atual='HUMANO' WHERE telefone=$1; INSERT INTO eventos (telefone, tipo, payload) VALUES ($1,'FALLBACK_HUMANO',$2::jsonb);",
        "options": {"queryReplacement":"={{ $('Normalize Input').item.json.telefone }},={{ JSON.stringify({mensagem:$('Normalize Input').item.json.mensagem,intencao:$('Parse AI JSON').item.json.intencao}) }}"}
      },
      "id": "node-humano",
      "name": "Flag Humano",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, 120],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SLACK_WEBHOOK_OPERACAO }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({text: '⚠️ Humano necessário: ' + $('Normalize Input').item.json.telefone + ' — ' + $('Normalize Input').item.json.mensagem}) }}"
      },
      "id": "node-slack-humano",
      "name": "Alerta Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 120]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clientes SET estado_atual='FINALIZADO', contexto='{}'::jsonb WHERE telefone=$1;",
        "options": {"queryReplacement":"={{ $('Normalize Input').item.json.telefone }}"}
      },
      "id": "node-cancelar",
      "name": "Reset Cliente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, 320],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://{{ $vars.BAILEYS_HOST }}/send-text",
        "sendHeaders": true,
        "headerParameters": {"parameters":[
          {"name":"Authorization","value":"=Bearer {{ $vars.BAILEYS_SERVICE_TOKEN }}"},
          {"name":"Content-Type","value":"application/json"}
        ]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Normalize Input').item.json.telefone, text: $('Parse AI JSON').item.json.resposta_cliente }) }}",
        "options": {"timeout": 10000}
      },
      "id": "node-send-wa",
      "name": "Enviar WhatsApp (Baileys)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 120]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversas (telefone, sender, mensagem, intencao) VALUES ($1,'bot',$2,$3);",
        "options": {"queryReplacement":"={{ $('Normalize Input').item.json.telefone }},={{ $('Parse AI JSON').item.json.resposta_cliente }},={{ $('Parse AI JSON').item.json.intencao }}"}
      },
      "id": "node-log-out",
      "name": "Log Msg Bot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1980, 120],
      "credentials": {"postgres": {"id": "PG_SALGADERIA", "name": "Postgres Salgaderia"}}
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true}",
        "options": {"responseCode": 200}
      },
      "id": "node-resp-ok",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2200, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": false}",
        "options": {"responseCode": 401}
      },
      "id": "node-resp-401",
      "name": "Responder 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1200, 400]
    }
  ],
  "connections": {
    "Webhook Baileys":          { "main": [[{"node": "Auth Token Baileys", "type": "main", "index": 0}]] },
    "Auth Token Baileys":       { "main": [
      [{"node": "Normalize Input", "type": "main", "index": 0}],
      [{"node": "Responder 401", "type": "main", "index": 0}]
    ]},
    "Normalize Input":          { "main": [[{"node": "Guard", "type": "main", "index": 0}]] },
    "Guard":                    { "main": [[{"node": "Upsert Cliente", "type": "main", "index": 0}], []] },
    "Upsert Cliente":           { "main": [[{"node": "Log Msg Cliente", "type": "main", "index": 0}]] },
    "Log Msg Cliente":          { "main": [[{"node": "Get Histórico", "type": "main", "index": 0}]] },
    "Get Histórico":            { "main": [[{"node": "Build AI Context", "type": "main", "index": 0}]] },
    "Build AI Context":         { "main": [[{"node": "AI Agent", "type": "main", "index": 0}]] },
    "OpenAI Chat Model":        { "ai_languageModel": [[{"node": "AI Agent", "type": "ai_languageModel", "index": 0}]] },
    "AI Agent":                 { "main": [[{"node": "Parse AI JSON", "type": "main", "index": 0}]] },
    "Parse AI JSON":            { "main": [[{"node": "Update Estado Cliente", "type": "main", "index": 0}]] },
    "Update Estado Cliente":    { "main": [[{"node": "Switch por acao", "type": "main", "index": 0}]] },
    "Switch por acao":          { "main": [
      [{"node": "Criar Pedido (DB)", "type": "main", "index": 0}],
      [{"node": "Flag Humano", "type": "main", "index": 0}],
      [{"node": "Reset Cliente", "type": "main", "index": 0}],
      [{"node": "Enviar WhatsApp (Baileys)", "type": "main", "index": 0}]
    ]},
    "Criar Pedido (DB)":        { "main": [[
      {"node": "Switch Pagamento", "type": "main", "index": 0},
      {"node": "Execute: Printer", "type": "main", "index": 0},
      {"node": "Execute: Google Calendar", "type": "main", "index": 0}
    ]]},
    "Switch Pagamento":         { "main": [
      [{"node": "Execute: MercadoPago Pix", "type": "main", "index": 0}],
      [{"node": "Enviar WhatsApp (Baileys)", "type": "main", "index": 0}]
    ]},
    "Execute: MercadoPago Pix": { "main": [[{"node": "Enviar WhatsApp (Baileys)", "type": "main", "index": 0}]] },
    "Execute: Printer":         { "main": [[]] },
    "Execute: Google Calendar": { "main": [[]] },
    "Flag Humano":              { "main": [[{"node": "Alerta Slack", "type": "main", "index": 0}]] },
    "Alerta Slack":             { "main": [[{"node": "Enviar WhatsApp (Baileys)", "type": "main", "index": 0}]] },
    "Reset Cliente":            { "main": [[{"node": "Enviar WhatsApp (Baileys)", "type": "main", "index": 0}]] },
    "Enviar WhatsApp (Baileys)":{ "main": [[{"node": "Log Msg Bot", "type": "main", "index": 0}]] },
    "Log Msg Bot":              { "main": [[{"node": "Responder 200", "type": "main", "index": 0}]] }
  },
  "active": false,
  "settings": {"executionOrder": "v1", "saveDataErrorExecution": "all"},
  "tags": [{"name": "salgaderia"}, {"name": "whatsapp"}, {"name": "baileys"}]
}

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sender, content, criado_em FROM conversations WHERE contact_id = $1::uuid ORDER BY criado_em DESC LIMIT 12;",
        "options": {"queryReplacement": "={{ $('When Called by Workflow').item.json.contact_id }}"}
      },
      "id": "node-history",
      "name": "Load History",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-1140, 400],
      "credentials": {"postgres": {"id": "PG_AGENT", "name": "Postgres Agent"}}
    },
    {
      "parameters": {
        "jsCode": "// Monta o contexto completo para o agent: tenant + contact + history + prompt interpolado\nconst t = $('Load Tenant').first().json;\nconst c = $('Load Contact').first().json;\nconst hist = $('Load History').all().map(i => ({ sender: i.json.sender, content: i.json.content })).reverse();\nconst input = $('When Called by Workflow').first().json;\n\n// Interpolação simples do prompt template\nlet prompt = $vars.SYSTEM_PROMPT_TEMPLATE || 'Você é o assistente de {{tenant.nome}}. {{tenant.config.prompt_extra}}';\nconst replacements = {\n  '{{tenant.nome}}': t.nome || '',\n  '{{tenant.slug}}': t.slug || '',\n  '{{tenant.timezone}}': t.timezone || 'America/Sao_Paulo',\n  '{{tenant.config.prompt_extra}}': t.config?.prompt_extra || '',\n  '{{tenant.config.business_hours}}': JSON.stringify(t.config?.business_hours || {}),\n  '{{tenant.config.language}}': t.config?.language || 'pt-BR',\n  '{{contact.nome}}': c?.nome || 'cliente',\n  '{{now}}': new Date().toISOString()\n};\nfor (const [k, v] of Object.entries(replacements)) prompt = prompt.split(k).join(v);\n\nreturn [{ json: {\n  tenant_id: t.id,\n  tenant: t,\n  contact_id: c.id,\n  contact: c,\n  channel: input.channel,\n  message: input.message,\n  media: input.media || null,\n  system_prompt: prompt,\n  history: hist,\n  tools_enabled: t.config?.tools_enabled || []\n}}];"
      },
      "id": "node-build-ctx",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-920, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversations (tenant_id, contact_id, channel, sender, content) VALUES ($1::uuid,$2::uuid,$3,'contact',$4);\nUPDATE contacts SET ultima_msg_em = NOW() WHERE id = $2::uuid;",
        "options": {"queryReplacement": "={{ $json.tenant_id }},={{ $json.contact_id }},={{ $json.channel }},={{ $json.message }}"}
      },
      "id": "node-log-in",
      "name": "Log Inbound",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-700, 400],
      "credentials": {"postgres": {"id": "PG_AGENT", "name": "Postgres Agent"}}
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Build Context').item.json.message }}",
        "options": {
          "systemMessage": "={{ $('Build Context').item.json.system_prompt }}\n\n## Contexto atual\n- Contato: {{ JSON.stringify($('Build Context').item.json.contact) }}\n- Histórico recente: {{ JSON.stringify($('Build Context').item.json.history) }}\n- Tools habilitadas para este tenant: {{ JSON.stringify($('Build Context').item.json.tools_enabled) }}\n\nUse APENAS as tools listadas em tools_enabled."
        }
      },

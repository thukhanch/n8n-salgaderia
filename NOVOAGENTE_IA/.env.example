# =========================================================================
# AGENT UNIVERSAL - ENV
# =========================================================================

# ----- Postgres -----
PG_PASSWORD=agent

# ----- n8n -----
N8N_HOST=n8n.seudominio.com
WEBHOOK_URL=https://n8n.seudominio.com
N8N_ENCRYPTION_KEY=gerar-com-openssl-rand-hex-32

# ----- Baileys (WhatsApp multi-instância) -----
BAILEYS_HOST=baileys:3001
BAILEYS_SERVICE_TOKEN=trocar-token-forte
BAILEYS_WEBHOOK_N8N_URL=http://n8n:5678/webhook/agent/whatsapp
BAILEYS_INSTANCES=demo

# ----- OpenAI (LLM do AI Agent) -----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ----- Mercado Pago (default / tenant pode sobrescrever em config.mp_access_token) -----
MP_ACCESS_TOKEN=APP_USR-xxxx
MP_WEBHOOK_URL=https://n8n.seudominio.com/webhook/agent/mp-webhook

# ----- Prompt (deixar vazio se preferir ler de prompts/system-prompt.md) -----
# Colar conteúdo de prompts/system-prompt.md aqui no n8n > Settings > Variables
SYSTEM_PROMPT_TEMPLATE=

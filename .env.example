# =========================================================================
# VARIÁVEIS DE AMBIENTE DO N8N (colar em Settings > Variables)
# =========================================================================

# ----- Postgres / Supabase -----
PG_HOST=db.xxxxxxxx.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=trocar-em-producao
PG_SSL=true

# ----- Evolution API (WhatsApp) -----
EVOLUTION_HOST=evolution.seudominio.com
EVOLUTION_INSTANCE=salgaderia
EVOLUTION_API_KEY=coloque-sua-api-key

# ----- OpenAI (LLM do AI Agent) -----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ----- Webhook para a Cozinha (TV/impressora/ERP) -----
WEBHOOK_COZINHA_URL=https://display-cozinha.seudominio.com/webhook
COZINHA_TOKEN=token-compartilhado-forte

# ----- Alertas operacionais (Slack/Discord webhook) -----
SLACK_WEBHOOK_OPERACAO=https://hooks.slack.com/services/xxx/yyy/zzz

# ----- Prompt do agente (conteúdo de prompts/ai-system-prompt.md) -----
# Colar o texto completo no campo "Variables" do n8n como PROMPT_DONA_SALGADA
PROMPT_DONA_SALGADA="Você é Dona Salgada... (colar o system prompt completo aqui)"

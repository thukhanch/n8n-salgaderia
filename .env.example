# =========================================================================
# VARIÁVEIS GLOBAIS (docker-compose + n8n Settings > Variables)
# =========================================================================

# ----- Postgres -----
PG_PASSWORD=trocar-em-producao
# (host=postgres, db=salgaderia, user=salgaderia quando usando docker-compose)

# ----- n8n -----
N8N_HOST=n8n.seudominio.com
WEBHOOK_URL=https://n8n.seudominio.com
N8N_ENCRYPTION_KEY=gerar-com-openssl-rand-hex-32

# ----- Baileys -----
BAILEYS_HOST=baileys:3001
BAILEYS_SERVICE_TOKEN=token-forte-compartilhado
BAILEYS_WEBHOOK_N8N_URL=http://n8n:5678/webhook/salgaderia/whatsapp

# ----- OpenAI (LLM do AI Agent + Whisper) -----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ----- Mercado Pago -----
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
MP_WEBHOOK_URL=https://n8n.seudominio.com/webhook/salgaderia/mp-webhook

# ----- Motoboy (escolha: lalamove | uber_direct | loggi | manual) -----
MOTOBOY_PROVIDER=lalamove

# Lalamove
LALAMOVE_API_KEY=xxxx
LALAMOVE_HMAC=xxxx

# Uber Direct
UBER_DIRECT_TOKEN=xxxx
UBER_CUSTOMER_ID=xxxx

# Loggi
LOGGI_API_KEY=xxxx
LOGGI_SHOP_ID=1234

# Dados da loja (usado pelo motoboy para pickup)
LOJA_NOME=Salgaderia do Bairro
LOJA_TELEFONE=+5511999999999
LOJA_ENDERECO=Rua dos Salgados, 100 - São Paulo/SP
LOJA_LAT=-23.550520
LOJA_LNG=-46.633308

# ----- Impressora térmica -----
PRINTER_HOST=printer:3002
PRINTER_SERVICE_TOKEN=token-forte-printer
PRINTER_TYPE=EPSON                 # EPSON | STAR
PRINTER_INTERFACE=tcp://192.168.1.50:9100
PRINTER_WIDTH=48
SHOP_NAME=SALGADERIA DO BAIRRO

# ----- Google Calendar -----
GCAL_CALENDAR_ID=primary           # ou ID completo do calendário compartilhado

# ----- Webhook para a Cozinha (display/ERP) -----
WEBHOOK_COZINHA_URL=https://display-cozinha.seudominio.com/webhook
COZINHA_TOKEN=token-forte-cozinha

# ----- Alertas (Slack/Discord) -----
SLACK_WEBHOOK_OPERACAO=https://hooks.slack.com/services/xxx/yyy/zzz

# ----- Prompt do agente IA (colar conteúdo de prompts/ai-system-prompt.md) -----
PROMPT_DONA_SALGADA="Você é Dona Salgada... (colar o system prompt completo)"
